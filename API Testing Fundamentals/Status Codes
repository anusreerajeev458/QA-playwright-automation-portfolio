                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Validate the response schema for 'data' object\", function () {\r",
                  "    const responseData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(responseData).to.be.an('object');\r",
                  "    pm.expect(responseData).to.have.property('data').that.is.an('object');\r",
                  "    \r",
                  "    const data = responseData.data;\r",
                  "    pm.expect(data).to.have.property('token').that.is.a('string');\r",
                  "    pm.expect(data).to.have.property('redirectTo').that.is.a('string');\r",
                  "    pm.expect(data).to.have.property('student').that.is.an('object');\r",
                  "\r",
                  "    const student = data.student;\r",
                  "    pm.expect(student).to.have.property('id').that.is.a('string');\r",
                  "    pm.expect(student).to.have.property('fullName').that.is.a('string');\r",
                  "    pm.expect(student).to.have.property('email').that.is.a('string').and.matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/, \"Email format is invalid\");\r",
                  "    pm.expect(student).to.have.property('isActive').that.is.a('boolean');\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Token is a non-empty string\", function () {\r",
                  "    const responseData = pm.response.json();\r",
                  "    \r",
                  "    pm.expect(responseData).to.have.property('data');\r",
                  "    pm.expect(responseData.data).to.have.property('token').that.is.a('string').and.to.have.lengthOf.at.least(1, \"Token should not be empty\");\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Student object contains required fields\", function () {\r",
                  "    const responseData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(responseData).to.be.an('object');\r",
                  "    pm.expect(responseData.data).to.exist.and.to.be.an('object');\r",
                  "    pm.expect(responseData.data.student).to.exist.and.to.be.an('object');\r",
                  "\r",
                  "    pm.expect(responseData.data.student).to.have.all.keys('id', 'fullName', 'email', 'isActive');\r",
                  "});\r",
                  "var responseData = pm.response.json();\r",
